            "name": "Get Attorney",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lexmachina.com/attorneys/:attorney_id",
            "params": [
              {
                "name": "attorney_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets data for a single attorney.\n\n- **attorney_id**: the Lex Machina attorneyId"
        },
