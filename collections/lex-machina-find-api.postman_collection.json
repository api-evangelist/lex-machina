          "id": "bf9116a7-76b1-430f-bb6e-e1aaa9d27d41",
          "name": "Find District Case By Number",
          "request": {
            "name": "Find District Case By Number",
            "description": {
              "content": "Finds Lex Machina case ids for specified case numbers.\n\n- **case_numbers**: case number search strings\n- **court**: optional court to limit results\n\nMatches results for each individual case number is cut off at 1000 match results.\n\nBecause case number formats vary, and because the case number for the same case can change over time, the search tries to err on the side of being more inclusive.\nSo, this may return more results than you expect.\nFor example, the search ignores judge initials at the end of case numbers.\nSo, for case number \"1:19-cv-00077-NLH-KMW\", the trailing initials \"NLH\" and \"KMW\" will be ignored.\n\nThe court param is optional and can be any of the name versions given by the /list-courts endpoint (must match capitalization).\nProviding a value for the court param will filter all case number searches in the request for cases within that court.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "find-district-cases"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "caseNumbers",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "caseNumbers",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "court",
                  "value": "<string>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
