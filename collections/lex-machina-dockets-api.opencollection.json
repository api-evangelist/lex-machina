                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets data for a single US ITC document.\n\n- **usitc_document_id**: The document id."
        },
