        {
          "info": {
            "name": "Get District Docket Entry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lexmachina.com/docket-entries/:docket_entry_id",
            "params": [
              {
                "name": "docket_entry_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets data for a single docket entry.\n\n- **docket_entry_id**: the Lex Machina docketEntryId.\n\nData returned for a docket will vary in format based on context, only the ids and urls for the relevant data will included."
        },
        {
          "info": {
            "name": "Get Itc Document Entry",
