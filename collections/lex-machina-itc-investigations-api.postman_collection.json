          "name": "Get Itc Investigation",
          "request": {
            "name": "Get Itc Investigation",
            "description": {
              "content": "Gets data for a single US ITC investigation.\n\n- **itc_investigation_id**: the ITC investigation number\n- **docket_retrieval**: docket retreival mode\n\nThe investigation number format should exclude the leading \"337-TA-\"",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "itc-investigations",
                ":itc_investigation_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "document_retrieval",
                  "value": "<string>",
                  "description": "'all' to retrieve all documents for the investigation, if not provided documents will not be returned."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "itc_investigation_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
