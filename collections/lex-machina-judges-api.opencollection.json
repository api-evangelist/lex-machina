            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lexmachina.com/bankruptcy-judges/:bankruptcy_judge_id",
            "params": [
              {
                "name": "bankruptcy_judge_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets data for a single federal bankruptcy judge.\n\n- **bankruptcy_judge_id**: the Lex Machina bankruptcyJudgeId"
        },
